# ==============================================================================
# APEX MOBILE E-COMMERCE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# In demo mode, the application runs out of the box with zero configuration!
# When you connect real backend databases or payment gateways, copy this file
# to '.env' and populate your production secrets.

# Storefront URLs
VITE_SITE_URL=https://apexmobile.vercel.app
VITE_STORE_CURRENCY=GBP

# Payment Gateway Keys (Optional - for live Stripe / PayPal integration)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_sample_key_here
# STRIPE_SECRET_KEY=sk_test_sample_key_here (Backend only - never expose in Vite!)

VITE_PAYPAL_CLIENT_ID=sample_paypal_client_id

# Database / Cloud Service Keys (Optional - for Firebase / Supabase)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# Supabase Alternatives
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
